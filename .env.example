# --- Modo Aiven (recomendado) ---
# Copiá este archivo a .env.local (NO subir a Git) y completá las URLs con tu contraseña Aiven.
# Guía de despliegue: docs/DEPLOY-ENV.md
VITE_MRV_API_URL=http://localhost:8787
# Front: registros CVS en Supabase (no saturan Aiven operativa)
VITE_USE_SUPABASE_REGISTROS=true
VITE_USE_SUPABASE_ORG=true
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_publica
# Solo padrón nominal (base_personas). Consultas de personas van aquí.
PADRON_DATABASE_URL=postgres://avnadmin:PASSWORD@mrv-pai-mrvpai.d.aivencloud.com:11822/defaultdb?sslmode=require
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-mrv-pai-mrv-pai-2026.j.aivencloud.com:21502/defaultdb
# OLD_DATABASE_URL=postgres://...instancia-llena...
JWT_SECRET=cambiar-por-clave-segura
# Capacidad (~800 brigadistas): pool chico en Vercel (auto), más grande en API persistente
# PG_POOL_MAX=2
# VITE_PADRON_STAGGER_MAX_SEC=120
# VITE_PADRON_PAGE_DELAY_MS=280
# RATE_LIMIT_PADRON_PAGE_PER_MIN=90
# En Vercel/Firebase Functions: lectura legacy de registros en Supabase
SUPABASE_SERVICE_ROLE_KEY=tu_service_role

# --- Supabase (legacy, solo si NO usás VITE_MRV_API_URL) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_publica
# SUPABASE_SERVICE_ROLE_KEY=  # solo scripts de importación
