# Supabase (ya configurado en el proyecto)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Solo anon (JWT) o publishable (sb_publishable_…). Nunca service_role ni sb_secret_ (falla en navegador/APK).
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_publica

# Mapa: OpenStreetMap vía Leaflet — no requiere clave ni facturación

# Importación masiva por script (npm run import:mrv-data): clave service_role, nunca en el cliente
# SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Actions (Settings → Secrets → Actions) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# ANDROID_KEYSTORE_BASE64=   # keystore.jks en base64 (Play Store)
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
